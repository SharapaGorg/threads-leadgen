# Резерв под будущий программный логин. Сейчас НЕ используются — auth идёт через cookies.
# Можно оставить пустыми, скрипты запустятся.
THREADS_USERNAME=
THREADS_PASSWORD=

# Локальная база.
DB_PATH=./data/leads.db

# Файл с cookies из браузера (JSON-массив). Читается напрямую.
# Положи туда экспорт от расширения "Cookie Editor" для threads.net.
SESSION_PATH=./data/session.json

# Часы активности скрапера (локальное время машины). Конец эксклюзивный: 09-23 = 09:00..22:59.
SCRAPER_ACTIVE_HOURS=09-23
